<?xml version="1.0" ?>
<robot name="simple_arm">

  <!-- Base link -->
  <link name="base"/>

  <!-- Joint 1: rotates around Z -->
  <link name="link1"/>
  <joint name="J1" type="revolute">
    <parent link="base"/>
    <child link="link1"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <!-- Joint 2: rotates around Y -->
  <link name="link2"/>
  <joint name="J2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0 0 20" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- Link length 1 -->
  <link name="link3"/>
  <joint name="J3" type="revolute">
    <parent link="link2"/>
    <child link="link3"/>
    <origin xyz="0 0 400" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- Link length 2 -->
  <link name="link4"/>
  <joint name="J4" type="revolute">
    <parent link="link3"/>
    <child link="link4"/>
    <origin xyz="0 0 400" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- Joint 5: rotates around X -->
  <link name="link5"/>
  <joint name="J5" type="revolute">
    <parent link="link4"/>
    <child link="link5"/>
    <origin xyz="0 0 20" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
  </joint>

  <!-- Joint 6: rotates around Z -->
  <link name="link6"/>
  <joint name="J6" type="revolute">
    <parent link="link5"/>
    <child link="link6"/>
    <origin xyz="0 0 20" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <!-- End-effector -->
  <link name="ee"/>
  <joint name="ee_fixed" type="fixed">
    <parent link="link6"/>
    <child link="ee"/>
    <origin xyz="0 0 20" rpy="0 0 0"/>
  </joint>

</robot>