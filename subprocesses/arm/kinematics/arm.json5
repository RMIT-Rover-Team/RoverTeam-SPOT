{
    name: "Arm",
    description: "A 6DOF Arm with gripper",
    joints: [
        {
            name: "J1",
            hardware: "odrive",
            limits: [-180, 180],
            axis: [0,0,1],
            home: 0,
            stow: 0,
            gearing: 1,
            linkTo: "L1"
        },
        {
            name: "J2",
            hardware: "myactuator",
            limits: [-180, 0],
            axis: [0,1,0],
            home: 0,
            stow: -45,
            gearing: 1,
            linkFrom: "L1",
            linkTo: "L2"
        },
        {
            name: "J3",
            hardware: "myactuator",
            limits: [-90, 90],
            axis: [0,1,0],
            home: 0,
            stow: 90,
            gearing: 1,
            linkFrom: "L2",
            linkTo: "L3"
        },
    ],
    links: [
        // All link lengths are in Metres
        {name: "L1", length: 0.05, vector: [0, 0, 1]},  // vertical
        {name: "L2", length: 0.510, vector: [1, 0, 0]},   // default X-forward
        {name: "L3", length: 0.475, vector: [1, 0, 0]}   // default X-forward
    ]
}